{
  "name": "proyecto1-pdr",
  "version": "1.0.0",
  "description": "Servidor y cliente RPC sobre TCP (net) con interfaz web",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "concurrently -n rpc,web -c blue,green \"npm:server\" \"npm:web\"",
    "server": "node server/index.js",
    "web": "node client/web-server.js",
    "client": "node client/client.js",
    "test": "node scripts/run-tests.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
